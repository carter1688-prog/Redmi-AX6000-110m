# Redmi AX6000 / MT7986A / hanwckf 110M UBI 大分区
# 目标分支：immortalwrt openwrt-24.10（只用 24.10；25.12 的 workflow 请 Disable）
#
# 插件清单就两样：PassWall（Xray + Sing-box 两个核心）+ MosDNS
# 其余一律不装。DNS 侧只留 PassWall 内置那套 + mosdns，不额外装数据包。
#
# 注意：PassWall 的 Haproxy / Shadowsocks_Rust_* / Simple_Obfs / V2ray_Geoview /
#       V2ray_Plugin / SingBox 默认值都是 y，不显式关掉就会被编进去。
#       下面那些 "# ... is not set" 的行都不能删。

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-110m=y

# ========== 基础系统组件（都是 passwall / mosdns 的运行时依赖）==========
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_terminfo=y

# ========== DNS：只留 PassWall 需要的那套 ==========
# dnsmasq-full 是 PassWall 的 nftset 域名分流所必需（精简版不支持 nftset）
CONFIG_PACKAGE_dnsmasq_full=y
# CONFIG_PACKAGE_dnsmasq is not set

# ========== PassWall：只留 Xray + Sing-box ==========
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y

# --- 以下全部显式关闭 ---
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Brook is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# CONFIG_PACKAGE_geoview is not set
# CONFIG_PACKAGE_haproxy is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_shadow-tls is not set
# CONFIG_PACKAGE_tuic-client is not set
# CONFIG_PACKAGE_brook is not set
# CONFIG_PACKAGE_xray-plugin is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-local is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_simple-obfs-client is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-local is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-redir is not set

# ========== DNS：MosDNS（与 AX6 保持一致：PassWall + MosDNS）==========
CONFIG_PACKAGE_luci-app-mosdns=y
# geosite/geoip 数据文件：PassWall 的"规则列表/分组规则"和 mosdns 的规则集都读它
CONFIG_PACKAGE_v2ray-geodata=y
# 明确不装 SmartDNS（两套 DNS 二选一，避免抢 53）
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_smartdns is not set

# ========== 代理相关内核模块（必须，全编进去）==========
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-reject=y
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_kmod-nf-ipt6=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-iptables=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_kmod-crypto-kpp=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y

# ========== 最小管理入口（只留两个：网页终端 + 文件传输）==========
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ========== 主题：保留 immortalwrt 默认的 argon（删了会导致网页界面异常）==========
CONFIG_PACKAGE_luci-theme-argon=y

# ========== LuCI 语言：24.10 与 25.12 都是 zh_Hans ==========
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_en=y
# CONFIG_LUCI_LANG_zh_Hant is not set
# CONFIG_LUCI_LANG_ja is not set
# CONFIG_LUCI_LANG_ru is not set
# CONFIG_LUCI_LANG_de is not set
# CONFIG_LUCI_LANG_fr is not set
# CONFIG_LUCI_LANG_es is not set
# CONFIG_LUCI_LANG_pt is not set
# CONFIG_LUCI_LANG_pl is not set
# CONFIG_LUCI_LANG_ko is not set
# CONFIG_LUCI_LANG_it is not set
# CONFIG_LUCI_LANG_cs is not set
# CONFIG_LUCI_LANG_hu is not set
# CONFIG_LUCI_LANG_tr is not set
# CONFIG_LUCI_LANG_vi is not set

# ========== 体积优化 ==========
CONFIG_OPTIMIZE_FOR_SIZE=y
CONFIG_STRIP_KERNEL_EXPORTS=y
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_PACKAGE_man is not set
# CONFIG_PACKAGE_doc is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_vim-full is not set
# CONFIG_PACKAGE_python3 is not set
# CONFIG_PACKAGE_perl is not set

# ========== 关闭 USB / 蓝牙 / 无用文件系统（AX6000 无 USB）==========
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-uhci is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-audio is not set
# CONFIG_PACKAGE_kmod-bluetooth is not set
# CONFIG_PACKAGE_kmod-fs-cifs is not set
# CONFIG_PACKAGE_kmod-fs-nfs is not set
# CONFIG_PACKAGE_kmod-fs-fuse is not set
